# Allow recovery domain to read battery sysfs and access firmware
# Note: write permissions on sysfs:file violate AOSP neverallows, do NOT add them here.
# Writing to sysfs during early boot is handled by the init domain.

# Battery / power supply sysfs read access
allow recovery sysfs:dir r_dir_perms;
allow recovery sysfs:file r_file_perms;
allow recovery sysfs:lnk_file r_file_perms;
allow recovery sysfs_batteryinfo:dir r_dir_perms;
allow recovery sysfs_batteryinfo:file r_file_perms;
allow recovery sysfs_batteryinfo:lnk_file r_file_perms;

# Firmware partition access
allow recovery firmware_file:dir r_dir_perms;
allow recovery firmware_file:file r_file_perms;
allow recovery firmware_file:lnk_file r_file_perms;

# VFAT mount access for firmware partition
allow recovery vfat:dir { r_dir_perms mounton };
allow recovery vfat:file r_file_perms;
