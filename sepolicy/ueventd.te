# Allow ueventd to search directories and load firmware for ADSP
allow ueventd firmware_file:dir r_dir_perms;
allow ueventd firmware_file:file r_file_perms;
allow ueventd firmware_file:lnk_file r_file_perms;

# Allow ueventd to search and load firmware from VFAT /firmware partition
allow ueventd vfat:dir r_dir_perms;
allow ueventd vfat:file r_file_perms;
allow ueventd vfat:lnk_file r_file_perms;

# Allow ueventd to search persist directory for firmware/bdf
allow ueventd mnt_vendor_file:dir r_dir_perms;
allow ueventd mnt_vendor_file:file r_file_perms;
allow ueventd mnt_vendor_file:lnk_file r_file_perms;
