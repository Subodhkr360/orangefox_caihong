# Allow kernel direct firmware loading from /firmware
allow kernel firmware_file:dir r_dir_perms;
allow kernel firmware_file:file r_file_perms;
allow kernel firmware_file:lnk_file r_file_perms;

# Allow kernel direct firmware loading from VFAT /firmware partition
allow kernel vfat:dir r_dir_perms;
allow kernel vfat:file r_file_perms;
allow kernel vfat:lnk_file r_file_perms;
